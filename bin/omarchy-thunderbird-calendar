#!/usr/bin/env python3
"""List upcoming events from the Thunderbird calendar store.

Thunderbird keeps calendar data in ``<profile>/calendar-data/<cal-id>.sqlite`` with a
``cal_events`` table. Timestamps there are **microseconds** since the Unix epoch — the
storage model divides by ``USECS_PER_SECOND = 1000000`` (CalStorageItemModel.sys.mjs) —
so a raw value of ``1700000000000000`` is 1700000000 seconds.

Recurring events store their RRULE in ``cal_recurrence.icalString`` (keyed by
``item_id``); those are expanded here rather than shown as their master date, because a
weekly meeting whose master is three months old would otherwise look like a stale past
event. A single occurrence you reschedule is a *detached exception*: a second
``cal_events`` row sharing the master's ``id`` with a non-null ``recurrence_id`` (the
original slot) and its own ``event_start`` (the new time). Those are emitted at the new
time and suppress the master's slot, so a moved meeting does not appear twice.

    omarchy-thunderbird-calendar               # upcoming events, human readable
    omarchy-thunderbird-calendar --days 1      # just today
    omarchy-thunderbird-calendar --json        # machine readable
    omarchy-thunderbird-calendar --count       # number of upcoming events

The database is copied to a temporary directory before reading, because Thunderbird
holds a lock on the live file while running.

Supported RRULE subset: FREQ (DAILY/WEEKLY/MONTHLY/YEARLY), INTERVAL, COUNT, UNTIL,
BYDAY and BYMONTHDAY. Cancelled occurrence days (EXDATE) are excluded and extra ones
(RDATE) included; a rule using other parts is not expanded (that event falls back to
its master occurrence). Zoned and UTC events render in the machine's local timezone;
all-day dates and floating events render exactly as stored (no offset shift), all-day
dates without a time of day. A UTC UNTIL/EXDATE (…Z) is converted to local time before
comparison so the boundary occurrence is not dropped.
"""

import argparse
import calendar as _calendar
import datetime
import json
import pathlib
import re
import shutil
import sqlite3
import subprocess
import sys
import tempfile

PLUGIN_DIR = pathlib.Path(__file__).resolve().parent.parent
USECS_PER_SECOND = 1000000
WEEKDAYS = {"MO": 0, "TU": 1, "WE": 2, "TH": 3, "FR": 4, "SA": 5, "SU": 6}
MAX_OCCURRENCES = 500
# CAL_ITEM_FLAG.EVENT_ALLDAY (calStorageHelpers.sys.mjs): the event is a date, not a
# time — its stored start is midnight *UTC*, so it must not be shifted to local time.
EVENT_ALLDAY = 8
# The event_*_tz value Thunderbird writes for a floating (zoneless) event: the stored
# time is the wall clock "as if UTC", so it is read back as stored.
FLOATING = "floating"


def usecs_to_epoch(usecs):
    """Microseconds-since-epoch (Thunderbird's storage unit) -> epoch seconds."""
    return int(usecs) // USECS_PER_SECOND


def to_datetime(usecs):
    return datetime.datetime.fromtimestamp(usecs_to_epoch(usecs))


def to_display(usecs, allday=False, floating=False):
    """The wall-clock datetime the user should see for a stored timestamp.

    Thunderbird stores the true UTC instant for zoned and UTC events — those convert
    to local time. But an all-day date is stored as midnight UTC and a floating event
    as its wall clock "as if UTC", so both are read back exactly as stored, with no
    timezone shift (a German machine would otherwise show a date-only event at 01:00
    or 02:00, and a floating event two hours late).
    """
    epoch = usecs_to_epoch(usecs)
    if allday or floating:
        return datetime.datetime.fromtimestamp(epoch, datetime.timezone.utc).replace(tzinfo=None)
    return datetime.datetime.fromtimestamp(epoch)


def unfold(text):
    """Undo RFC 5545 line folding (a continuation line begins with space or tab)."""
    return re.sub(r"\r?\n[ \t]", "", text or "")


def parse_rrule(ical_string):
    """The RRULE of an iCalendar blob as a dict, or None when there is not one."""
    for line in unfold(ical_string).splitlines():
        line = line.strip()
        if not line.upper().startswith("RRULE"):
            continue
        value = line.split(":", 1)[1] if ":" in line else ""
        rule = {}
        for part in value.split(";"):
            if "=" not in part:
                continue
            key, _, val = part.partition("=")
            rule[key.upper()] = val
        return rule or None
    return None


def parse_datetime_list(line):
    """'EXDATE;TZID=X:20260605T090000Z,20260612T090000Z' -> [naive datetimes].

    Anything from the first colon on is the value; date-time parameters (TZID etc.)
    come before it and are ignored, as are values we cannot parse.
    """
    if ":" not in line:
        return []
    found = []
    for part in line.split(":", 1)[1].split(","):
        value = part.strip()
        parsed = parse_until(value)
        if parsed is None:
            continue
        # A UTC value (…Z) names an instant: bring it into the local frame the
        # occurrences are expanded in. A bare date / floating value stays as-is.
        if value.upper().endswith("Z"):
            parsed = _utc_to_local(parsed)
        found.append(parsed)
    return found


def parse_recurrence_rows(rows):
    """Combine cal_recurrence rows into {item_id: {rule, exdate, rdate}}.

    Thunderbird stores one recurrence *element* per row — the RRULE, and separately
    each EXDATE/RDATE — all sharing the item_id, so a row-by-row overwrite would lose
    the RRULE as soon as the event also had a cancelled occurrence.
    """
    combined = {}
    for item_id, ical in rows:
        text = unfold(ical or "")
        entry = combined.setdefault(item_id, {"rule": None, "exdate": set(), "rdate": []})
        rule = parse_rrule(text)
        if rule:
            entry["rule"] = rule
        for line in text.splitlines():
            line = line.strip()
            upper = line.upper()
            if upper.startswith("EXDATE"):
                for moment in parse_datetime_list(line):
                    entry["exdate"].add(int(moment.timestamp()))
            elif upper.startswith("RDATE"):
                entry["rdate"].extend(parse_datetime_list(line))
    return combined


def parse_until(value):
    """RRULE UNTIL -> naive datetime. Accepts YYYYMMDD and YYYYMMDDTHHMMSSZ."""
    raw = value.strip().rstrip("Z")
    for fmt in ("%Y%m%dT%H%M%S", "%Y%m%d"):
        try:
            return datetime.datetime.strptime(raw, fmt)
        except ValueError:
            continue
    return None


def _utc_to_local(moment):
    """A naive UTC datetime -> the same instant as a naive local datetime."""
    return datetime.datetime.fromtimestamp(
        moment.replace(tzinfo=datetime.timezone.utc).timestamp())


def until_as_local(value):
    """RRULE UNTIL in the frame the occurrences are expanded in.

    A UTC UNTIL (…Z) names an instant, so it is converted to local time before the
    comparison; a bare date (an all-day series) is compared as-is. Skipping this
    conversion drops the last occurrence of a series whose local time is ahead of
    the UTC UNTIL (e.g. a 22:00 Berlin event with UNTIL=…T210000Z).
    """
    moment = parse_until(value)
    if moment is not None and value.strip().upper().endswith("Z"):
        return _utc_to_local(moment)
    return moment


def _weekly_occurrences(start, interval, byday, horizon, limit):
    out = []
    week_start = start - datetime.timedelta(days=start.weekday())
    days = sorted(WEEKDAYS[d] for d in byday if d in WEEKDAYS) if byday else [start.weekday()]
    step = 0
    while len(out) < limit:
        base = week_start + datetime.timedelta(weeks=step * interval)
        if base > horizon:
            break
        for offset in days:
            occ = base + datetime.timedelta(days=offset)
            if occ >= start and occ <= horizon:
                out.append(occ)
                if len(out) >= limit:
                    break
        step += 1
    return sorted(out)


def _daily_occurrences(start, interval, byday, horizon, limit):
    out = []
    day = start
    while day <= horizon and len(out) < limit:
        if not byday or day.weekday() in [WEEKDAYS[d] for d in byday if d in WEEKDAYS]:
            out.append(day)
        day += datetime.timedelta(days=interval)
    return out


def _monthly_occurrences(start, interval, bymonthday, horizon, limit):
    out = []
    days = bymonthday or [start.day]
    year, month, step = start.year, start.month, 0
    while len(out) < limit:
        y = year + (month - 1 + step * interval) // 12
        m = (month - 1 + step * interval) % 12 + 1
        first = datetime.datetime(y, m, 1)
        if first > horizon:
            break
        for day in days:
            try:
                # Preserve the event's time-of-day (and tz-naivity); only move the date.
                occ = start.replace(year=y, month=m, day=day)
            except ValueError:
                continue
            if occ >= start and occ <= horizon:
                out.append(occ)
                if len(out) >= limit:
                    break
        step += 1
    return sorted(out)


def _yearly_occurrences(start, interval, horizon, limit):
    out = []
    year = start.year
    while len(out) < limit:
        try:
            occ = start.replace(year=year)
        except ValueError:  # Feb 29 in a non-leap year
            year += interval
            continue
        if occ > horizon:
            break
        if occ >= start:
            out.append(occ)
        year += interval
    return out


def expand_occurrences(start, rule, horizon, limit=MAX_OCCURRENCES):
    """Occurrences of a recurring event from `start` up to `horizon` (naive datetimes).

    Returns [] for a rule with an unsupported FREQ, so the caller falls back to the
    master occurrence.
    """
    if not rule:
        return [start]
    freq = str(rule.get("FREQ", "")).upper()
    try:
        interval = max(1, int(rule.get("INTERVAL", 1)))
    except (TypeError, ValueError):
        interval = 1
    byday = [d.strip().upper() for d in rule.get("BYDAY", "").split(",") if d.strip()]
    bymonthday = []
    for raw in rule.get("BYMONTHDAY", "").split(","):
        raw = raw.strip()
        if raw.lstrip("-").isdigit():
            bymonthday.append(int(raw))

    if freq == "DAILY":
        found = _daily_occurrences(start, interval, byday, horizon, limit)
    elif freq == "WEEKLY":
        found = _weekly_occurrences(start, interval, byday, horizon, limit)
    elif freq == "MONTHLY":
        found = _monthly_occurrences(start, interval, bymonthday, horizon, limit)
    elif freq == "YEARLY":
        found = _yearly_occurrences(start, interval, horizon, limit)
    else:
        return []

    count = rule.get("COUNT")
    if count is not None:
        try:
            found = found[:max(0, int(count))]
        except (TypeError, ValueError):
            pass
    until = until_as_local(rule["UNTIL"]) if "UNTIL" in rule else None
    if until is not None:
        found = [o for o in found if o <= until]
    return found


def load_events(db_path: pathlib.Path, workdir: pathlib.Path):
    """Events from one calendar database, or [] if it is not a calendar store.

    The file (and its -wal/-shm siblings) are copied first so a running Thunderbird's
    lock does not block the read.
    """
    staged = workdir / db_path.name
    for suffix in ("", "-wal", "-shm"):
        src = pathlib.Path(str(db_path) + suffix)
        if src.is_file():
            shutil.copy2(src, str(staged) + suffix)
    if not staged.is_file():
        return []
    events = []
    try:
        conn = sqlite3.connect(str(staged))
        try:
            rows = conn.execute(
                "SELECT id, cal_id, title, event_start, event_end, ical_status, "
                "recurrence_id, flags, event_start_tz FROM cal_events").fetchall()
            recs = {}
            try:
                recs = parse_recurrence_rows(conn.execute(
                    "SELECT item_id, icalString FROM cal_recurrence").fetchall())
            except sqlite3.Error:
                recs = {}
        finally:
            conn.close()
    except sqlite3.Error:
        return []

    masters = {}
    exceptions = []
    for eid, cal_id, title, start, end, status, recurrence_id, flags, start_tz in rows:
        if start is None:
            continue
        event = {
            "id": eid,
            "calendar": cal_id,
            "title": title or "(no title)",
            "start_usecs": int(start),
            "end_usecs": int(end) if end is not None else int(start),
            "status": status or "",
            "allday": bool((flags or 0) & EVENT_ALLDAY),
            "floating": start_tz == FLOATING,
        }
        if recurrence_id:
            # A detached exception: it carries the master's id and the *original*
            # occurrence start, while its own event_start is the new time.
            event["override_of"] = int(recurrence_id)
            event["rule"] = None
            exceptions.append(event)
        else:
            info = recs.get(eid) or {}
            event["rule"] = info.get("rule")
            event["exdate"] = info.get("exdate") or set()
            event["rdate"] = info.get("rdate") or []
            masters[(cal_id, eid)] = event

    # Tell each master which of its occurrence slots an exception has taken over.
    for event in masters.values():
        event["exceptions"] = set()
    for event in exceptions:
        master = masters.get((event["calendar"], event["id"]))
        if master is not None:
            master["exceptions"].add(event["override_of"] // USECS_PER_SECOND)

    return list(masters.values()) + exceptions


def scan_profile(profile: pathlib.Path):
    """All events across every calendar store in the profile."""
    events = []
    data_dir = profile / "calendar-data"
    if not data_dir.is_dir():
        return events
    with tempfile.TemporaryDirectory() as tmp:
        workdir = pathlib.Path(tmp)
        for db in sorted(data_dir.glob("*.sqlite")):
            events.extend(load_events(db, workdir))
    return events


def _occurrences_of(event, horizon, limit=MAX_OCCURRENCES):
    """Concrete (start, end) datetimes for an event, expanding recurrence if any.

    Times are placed in the frame the user should see: zoned and UTC events in local
    time, all-day dates and floating events exactly as stored.
    """
    allday = event.get("allday", False)
    floating = event.get("floating", False)
    master_start = to_display(event["start_usecs"], allday, floating)
    duration = to_display(event["end_usecs"], allday, floating) - master_start
    if event.get("override_of"):
        # A detached exception is a single event at its own (new) time: expanding it
        # would resurrect the whole series.
        return [(master_start, master_start + duration)]
    rule = event.get("rule")
    if not rule:
        return [(master_start, master_start + duration)]
    starts = expand_occurrences(master_start, rule, horizon, limit)
    if not starts:
        # Unsupported rule: fall back to the master occurrence rather than hiding it.
        return [(master_start, master_start + duration)]
    # Drop the slots an exception has taken over (it is emitted at its new time as a
    # separate event) and any occurrence explicitly excluded with an EXDATE; then add
    # any RDATE. Occurrences land in a set first, so an RDATE on an existing slot does
    # not duplicate it.
    excluded = set(event.get("exceptions") or ()) | set(event.get("exdate") or ())
    starts = [s for s in starts if int(s.timestamp()) not in excluded]
    for moment in event.get("rdate") or []:
        if master_start <= moment <= horizon and int(moment.timestamp()) not in excluded:
            starts.append(moment)
    return [(s, s + duration) for s in sorted(set(starts))]


def upcoming(events, now=None, days=7):
    """Non-cancelled occurrences that have not ended, within `days` from now."""
    now = now or datetime.datetime.now()
    horizon = now + datetime.timedelta(days=days)
    keep = []
    now_epoch = now.timestamp()
    horizon_epoch = horizon.timestamp()
    for event in events:
        if event["status"].upper() == "CANCELLED":
            continue
        for start, end in _occurrences_of(event, horizon):
            # Compare as instants so events in different frames (local, floating,
            # all-day) are filtered and ordered consistently.
            if end.timestamp() >= now_epoch and start.timestamp() <= horizon_epoch:
                entry = dict(event)
                allday = event.get("allday", False)
                entry["start"] = (start.date().isoformat() if allday
                                  else start.isoformat(timespec="minutes"))
                entry["end"] = (end.date().isoformat() if allday
                                else end.isoformat(timespec="minutes"))
                entry["start_usecs"] = int(start.timestamp()) * USECS_PER_SECOND
                keep.append(entry)
    keep.sort(key=lambda e: e["start_usecs"])
    return keep


def resolve_profile(explicit):
    if explicit:
        return pathlib.Path(explicit)
    finder = PLUGIN_DIR / "bin/omarchy-tb-profile"
    result = subprocess.run([sys.executable, str(finder)], capture_output=True, text=True)
    if result.returncode != 0 or not result.stdout.strip():
        return None
    return pathlib.Path(result.stdout.strip())


def main(argv=None) -> int:
    parser = argparse.ArgumentParser(description="Upcoming Thunderbird calendar events")
    parser.add_argument("--profile", default=None)
    parser.add_argument("--days", type=int, default=7)
    parser.add_argument("--json", action="store_true")
    parser.add_argument("--count", action="store_true")
    args = parser.parse_args(argv)

    profile = resolve_profile(args.profile)
    if profile is None or not profile.is_dir():
        print("omarchy-thunderbird-calendar: no Thunderbird profile found", file=sys.stderr)
        return 1

    events = upcoming(scan_profile(profile), days=args.days)
    if args.count:
        print(len(events))
    elif args.json:
        print(json.dumps({"count": len(events), "events": [
            {"title": e["title"], "start": e["start"], "end": e["end"],
             "calendar": e["calendar"], "all_day": e.get("allday", False)}
            for e in events]}, indent=2))
    else:
        if not events:
            print("No upcoming events.")
        for event in events:
            print("%s  %s" % (event["start"], event["title"]))
    return 0


if __name__ == "__main__":
    sys.exit(main())
