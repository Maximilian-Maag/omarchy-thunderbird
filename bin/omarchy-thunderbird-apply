#!/usr/bin/env python3
"""Render the declarative config into the Thunderbird profile.

Configuration that only lives in a UI is configuration you cannot review, diff, or
test. This tool turns the files under ``config/`` into the profile's ``user.js``:

* ``config/settings.json`` — plain preference overrides (machine/user specific)
* ``config/tags.json``     — tag definitions -> ``mailnews.tags.<key>.{tag,color}``
* ``config/chat.json``     — chat accounts -> the account manager (optional)

Chat accounts are *registered*, not just configured: Thunderbird enumerates them from
``MailServices.accounts`` (``imAccounts.sys.mjs`` ``initAccounts()``), so an account only
exists once ``mail.accountmanager.accounts`` lists it and a ``type=im`` incoming server
with ``imAccount = account<N>`` points at it — writing the ``messenger.account.<key>.*``
prefs alone creates nothing. ``apply`` therefore writes those account-manager prefs, plus
the account's ``messenger.account.account<N>.*`` config (a nickname is
``...options.username``), into the profile's ``prefs.js``. It is ``prefs.js`` and not
``user.js`` on purpose: ``user.js`` is re-applied every startup and would override
Thunderbird's own account management, silently dropping any account added later in the
UI. ``apply`` refuses to write while Thunderbird is running.

The shipped ``profile/user.js`` is the base; config overrides it (later ``user_pref``
calls win), and any pref lines a user added by hand to their own ``user.js`` are
preserved as long as they are not managed here. The result is written atomically.

Usage:
    omarchy-thunderbird-apply                 # write the profile's user.js
    omarchy-thunderbird-apply --print         # print to stdout (dry run)
    omarchy-thunderbird-apply --profile P     # target a specific profile
"""

import argparse
import json
import os
import pathlib
import re
import subprocess
import sys

PLUGIN_DIR = pathlib.Path(__file__).resolve().parent.parent
TAG_KEY = re.compile(r"^[A-Za-z0-9_-]+$")
COLOR = re.compile(r"^#[0-9A-Fa-f]{6}$")
PREF_KEY = re.compile(r'user_pref\(\s*"([^"]+)"')
# A whole prefs.js/user.js line, capturing the key and the raw JS value (for prefs.js).
PREF_LINE = re.compile(r'^\s*user_pref\(\s*"([^"]+)"\s*,\s*(.*?)\s*\);\s*$')


class ThunderbirdRunning(Exception):
    """Chat accounts were declared but Thunderbird is up, so prefs.js cannot be written."""


def load_tags(path: pathlib.Path):
    """Validate and return the tag list from a tags.json file."""
    data = json.loads(path.read_text())
    tags = data.get("tags")
    if not isinstance(tags, list) or not tags:
        raise ValueError("%s: 'tags' must be a non-empty list" % path)
    seen = set()
    for tag in tags:
        key = tag.get("key", "")
        if not TAG_KEY.match(key):
            raise ValueError("%s: bad tag key %r (want [A-Za-z0-9_-]+)" % (path, key))
        if key in seen:
            raise ValueError("%s: duplicate tag key %r" % (path, key))
        seen.add(key)
        if not COLOR.match(str(tag.get("color", ""))):
            raise ValueError("%s: bad colour for %r (want #RRGGBB)" % (path, key))
        if not str(tag.get("name", "")).strip():
            raise ValueError("%s: tag %r has no name" % (path, key))
    return tags


def load_settings(path: pathlib.Path):
    """Return validated {pref: value} from a settings.json file."""
    data = json.loads(path.read_text())
    prefs = data.get("prefs", {})
    if not isinstance(prefs, dict):
        raise ValueError("%s: 'prefs' must be an object" % path)
    for key, value in prefs.items():
        if not str(key).strip():
            raise ValueError("%s: empty pref key" % path)
        if not isinstance(value, (bool, int, float, str)):
            raise ValueError("%s: pref %s has a non-literal value %r" % (path, key, value))
    return prefs


def tags_to_prefs(tags):
    """{pref: value} for a validated tag list."""
    prefs = {}
    for tag in tags:
        key = tag["key"]
        prefs["mailnews.tags.%s.tag" % key] = str(tag["name"])
        prefs["mailnews.tags.%s.color" % key] = str(tag["color"])
    return prefs


def load_chat_accounts(path: pathlib.Path):
    """Validate and return the chat accounts from a chat.json file.

    A missing file is not an error (chat is optional): it means "no accounts to add".
    Each account carries an integer ``id`` — the Thunderbird account number. It cannot be
    an arbitrary name: Thunderbird keys chat accounts by ``account<N>`` (``imAccounts
    .sys.mjs``: ``numericId = parseInt(key.substr("account".length))``) and enumerates
    them from the account manager, so the id decides which ``account<N>`` is created.
    """
    if not path.is_file():
        return []
    data = json.loads(path.read_text())
    accounts = data.get("accounts", [])
    if not isinstance(accounts, list):
        raise ValueError("%s: 'accounts' must be a list" % path)
    seen = set()
    for account in accounts:
        aid = account.get("id")
        if not isinstance(aid, int) or isinstance(aid, bool) or aid < 1:
            raise ValueError("%s: account 'id' must be a positive integer (got %r)"
                             % (path, aid))
        if aid in seen:
            raise ValueError("%s: duplicate account id %r" % (path, aid))
        seen.add(aid)
        if not str(account.get("name", "")).strip():
            raise ValueError("%s: account %r has no name" % (path, aid))
        protocol = str(account.get("protocol", ""))
        if not protocol.startswith("prpl-"):
            raise ValueError("%s: account %r protocol %r must start with 'prpl-'"
                             % (path, aid, protocol))
        if "autoLogin" in account and not isinstance(account["autoLogin"], bool):
            raise ValueError("%s: account %r autoLogin must be a boolean" % (path, aid))
        for optional in ("username", "autoJoin"):
            if optional in account and not isinstance(account[optional], str):
                raise ValueError("%s: account %r %s must be a string" % (path, aid, optional))
    return accounts


def account_manager_prefs(existing, accounts):
    """{pref: value} registering each declared chat account with Thunderbird's account
    manager, or {} when there is nothing to add.

    Thunderbird enumerates chat accounts from ``MailServices.accounts`` (``imAccounts
    .sys.mjs`` ``initAccounts()``): a chat account only exists once
    ``mail.accountmanager.accounts`` lists it and a ``type=im`` incoming server with
    ``imAccount = account<N>`` points at it. Writing the ``messenger.account.<key>.*``
    prefs alone creates nothing.

    ``existing`` is the profile's current ``prefs.js`` (key -> raw JS value). It supplies
    the accounts already registered — preserved so they are never dropped — and the server
    numbers in use, so a new server id cannot collide. The account/server ids are reused
    when the account already exists, so a re-run is idempotent.
    """
    listed = [a for a in _unquote(existing.get("mail.accountmanager.accounts", '""')).split(",") if a]
    used_servers = set()
    for key in existing:
        match = re.match(r"^mail\.server\.(server\d+)\.", key)
        if match:
            used_servers.add(match.group(1))

    updates = {}
    wanted = []
    for account in accounts:
        akey = "account%d" % account["id"]
        server = _unquote(existing.get("mail.account.%s.server" % akey, '""'))
        if server:
            kind = _unquote(existing.get("mail.server.%s.type" % server, '""'))
            if kind != "im":
                raise ValueError(
                    "account %s is already a %r account; pick another id" % (akey, kind or "?"))
        else:
            server = _next_free_server(used_servers)
            used_servers.add(server)
            updates["mail.account.%s.server" % akey] = server
        updates["mail.server.%s.type" % server] = "im"
        updates["mail.server.%s.hostname" % server] = str(account["protocol"])
        updates["mail.server.%s.userName" % server] = str(account["name"])
        updates["mail.server.%s.imAccount" % server] = akey
        base = "messenger.account.%s." % akey
        updates[base + "name"] = str(account["name"])
        updates[base + "prpl"] = str(account["protocol"])
        updates[base + "autoLogin"] = bool(account.get("autoLogin", False))
        if account.get("autoJoin"):
            updates[base + "autoJoin"] = str(account["autoJoin"])
        if account.get("username"):
            updates[base + "options.username"] = str(account["username"])
        wanted.append(akey)

    if wanted:
        updates["mail.accountmanager.accounts"] = ",".join(
            listed + [a for a in wanted if a not in listed])
    return updates


def _unquote(raw):
    """A raw prefs.js JS value as a plain string (string literals only)."""
    raw = str(raw).strip()
    if len(raw) >= 2 and raw.startswith('"') and raw.endswith('"'):
        return raw[1:-1].replace('\\"', '"').replace("\\\\", "\\")
    return raw


def _next_free_server(used):
    """The first 'server<N>' not already in `used`."""
    n = 1
    while ("server%d" % n) in used:
        n += 1
    return "server%d" % n


def read_prefs(path: pathlib.Path):
    """{key: raw JS value} from a prefs.js body (last write wins)."""
    prefs = {}
    if path.is_file():
        for line in path.read_text(errors="replace").splitlines():
            match = PREF_LINE.match(line)
            if match:
                prefs[match.group(1)] = match.group(2)
    return prefs


def upsert_pref_lines(text: str, updates) -> str:
    """prefs.js text with `updates` applied: existing lines replaced, new ones appended.

    Only whole ``user_pref("key", ...);`` lines are touched, so comments and any foreign
    content are preserved and a re-run does not accumulate duplicates.
    """
    remaining = dict(updates)
    out = []
    for line in text.splitlines():
        match = PREF_LINE.match(line)
        if match and match.group(1) in remaining:
            out.append('user_pref("%s", %s);' % (match.group(1), literal(remaining.pop(match.group(1)))))
        else:
            out.append(line)
    for key, value in remaining.items():
        out.append('user_pref("%s", %s);' % (key, literal(value)))
    return "\n".join(out).rstrip("\n") + "\n"


def thunderbird_running():
    """True when a Thunderbird process is up (it would overwrite prefs.js on exit)."""
    try:
        result = subprocess.run(["pgrep", "-x", "thunderbird"], capture_output=True)
    except OSError:
        return False
    return result.returncode == 0


def provision_accounts(profile: pathlib.Path, accounts):
    """Write the account-manager registration for `accounts` into the profile's prefs.js.

    Returns the number of accounts declared. prefs.js — not user.js — is deliberate:
    user.js is re-applied every startup and would override Thunderbird's own account
    management, silently dropping any account the user adds later in the UI. Refuses to
    write while Thunderbird is running, since it would discard the change on exit.
    """
    if not accounts:
        return 0
    prefs_path = profile / "prefs.js"
    updates = account_manager_prefs(read_prefs(prefs_path), accounts)
    if not updates:
        return 0
    if thunderbird_running():
        raise ThunderbirdRunning(
            "Thunderbird is running; close it so the chat accounts can be written to "
            "prefs.js (it would overwrite them on exit)")
    text = prefs_path.read_text(errors="replace") if prefs_path.is_file() else ""
    write_atomic(prefs_path, upsert_pref_lines(text, updates))
    return len(accounts)


def literal(value) -> str:
    """A value rendered as a JS literal for user_pref()."""
    if isinstance(value, bool):
        return "true" if value else "false"
    if isinstance(value, (int, float)):
        return str(value)
    return '"%s"' % str(value).replace("\\", "\\\\").replace('"', '\\"')


def pref_lines(prefs) -> str:
    lines = []
    for key in prefs:
        lines.append('user_pref("%s", %s);' % (key, literal(prefs[key])))
    return "\n".join(lines)


def keys_in(text) -> set:
    return set(PREF_KEY.findall(text))


def _drop_managed(text, managed):
    """Lines whose pref key is in `managed` are removed; everything else kept."""
    kept = []
    for line in text.splitlines():
        match = PREF_KEY.search(line)
        if match and match.group(1) in managed:
            continue
        kept.append(line)
    return kept


def build_userjs(base_text: str, config_prefs, existing_text: str = "") -> str:
    """base user.js + config overrides, preserving foreign prefs from `existing`.

    Every pref key is emitted exactly once: base lines overridden by config are
    dropped (the override block re-emits them, so it wins), and duplicate keys in a
    user.js are avoided entirely rather than relying on last-write-wins.
    """
    override_keys = set(config_prefs)
    managed = override_keys | keys_in(base_text)

    base_kept = "\n".join(_drop_managed(base_text, override_keys)).rstrip("\n")
    # Only real pref lines from the existing file are preserved (and only if we do not
    # manage that key). Comment/blank lines are dropped so a re-run is idempotent
    # rather than accumulating our own generated markers as "foreign" content.
    foreign = []
    for line in existing_text.splitlines():
        match = PREF_KEY.search(line)
        if match and match.group(1) not in managed:
            foreign.append(line)

    parts = [base_kept]
    override_block = pref_lines(config_prefs)
    if override_block:
        parts.append("// ── config/ overrides (generated by omarchy-thunderbird-apply) ──\n"
                     + override_block)
    if foreign:
        parts.append("// ── prefs preserved from the existing user.js ──\n" + "\n".join(foreign))
    return "\n\n".join(part for part in parts if part) + "\n"


def write_atomic(path: pathlib.Path, text: str) -> None:
    """Write text, replacing the file — never following a symlink to its target."""
    tmp = path.with_name(path.name + ".tmp")
    tmp.write_text(text)
    os.replace(tmp, path)


def resolve_profile(explicit):
    if explicit:
        return pathlib.Path(explicit)
    finder = PLUGIN_DIR / "bin/omarchy-tb-profile"
    result = subprocess.run([sys.executable, str(finder)], capture_output=True, text=True)
    if result.returncode != 0 or not result.stdout.strip():
        return None
    return pathlib.Path(result.stdout.strip())


def main(argv=None) -> int:
    parser = argparse.ArgumentParser(description="Apply declarative Thunderbird config")
    parser.add_argument("--profile", default=None)
    parser.add_argument("--config-dir", default=str(PLUGIN_DIR / "config"))
    parser.add_argument("--print", dest="dry_run", action="store_true")
    args = parser.parse_args(argv)

    config_dir = pathlib.Path(args.config_dir)
    try:
        tags = load_tags(config_dir / "tags.json")
        settings = load_settings(config_dir / "settings.json")
        accounts = load_chat_accounts(config_dir / "chat.json")
    except (OSError, ValueError) as exc:
        print("omarchy-thunderbird-apply: %s" % exc, file=sys.stderr)
        return 1

    config_prefs = {}
    config_prefs.update(tags_to_prefs(tags))
    config_prefs.update(settings)

    profile = resolve_profile(args.profile)
    if profile is None or not profile.is_dir():
        print("omarchy-thunderbird-apply: no Thunderbird profile found", file=sys.stderr)
        return 1

    base = (PLUGIN_DIR / "profile/user.js").read_text()
    existing = ""
    target = profile / "user.js"
    if target.is_file():
        existing = target.read_text()

    rendered = build_userjs(base, config_prefs, existing)
    if args.dry_run:
        sys.stdout.write(rendered)
        if accounts:
            sys.stdout.write("// chat accounts (written to prefs.js, not user.js): %s\n"
                             % ", ".join("account%d" % a["id"] for a in accounts))
        return 0

    write_atomic(target, rendered)
    try:
        provisioned = provision_accounts(profile, accounts)
    except ThunderbirdRunning as exc:
        # Not a config error: the prefs were applied, only the account registration was
        # skipped. Warn loudly but succeed, so an installer under `set -e` does not abort.
        print("omarchy-thunderbird-apply: %s" % exc, file=sys.stderr)
        print("omarchy-thunderbird: applied %d tag(s) and %d setting(s) to %s; "
              "chat accounts NOT applied" % (len(tags), len(settings), target))
        return 0
    except (OSError, ValueError) as exc:
        print("omarchy-thunderbird-apply: %s" % exc, file=sys.stderr)
        return 1
    print("omarchy-thunderbird: applied %d tag(s), %d setting(s) and %d chat account(s) to %s"
          % (len(tags), len(settings), provisioned, target))
    return 0


if __name__ == "__main__":
    sys.exit(main())
