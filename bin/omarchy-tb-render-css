#!/usr/bin/env python3
"""Render the applied Thunderbird stylesheets for a given Omarchy theme.

Two kinds are produced from the same theme palette, so the chrome and the message
body never drift apart:

* ``--kind chrome``  → ``userChrome.css``: the active theme inlined into the
  stylesheet's default ``:root`` block.
* ``--kind content`` → ``userContent.css``: the message-reading pane, recoloured from
  the same theme's variables.

Why this exists
---------------
The bundled chrome stylesheet selects a theme with an attribute selector,
``:root[data-omarchy-theme="nord"]``, which is only ever set by a userChromeJS
loader. On a stock Thunderbird (no loader) that attribute is never present, so every
theme silently fell back to the first ``:root`` block — catppuccin — and switching
themes appeared to do nothing.

This tool removes the dependency entirely: it *inlines* the requested theme's
declarations into the fallback ``:root`` block, producing a plain stylesheet that
works with no loader. The attribute blocks are kept untouched for anyone who does run
a loader.

It is pure text in, text out — no theme knowledge of its own — so the hook and the
installer both call it, and the palette keeps a single source of truth
(themes/userChrome.css).
"""

import argparse
import os
import pathlib
import re
import sys

FALLBACK_BLOCK = re.compile(r"(:root\s*\{)(.*?)(\})", re.S)
DECL = re.compile(r"(--[a-z-]+)\s*:\s*([^;]+);")

# Content-pane variable -> the chrome variable it is drawn from.
CONTENT_MAP = {
    "bg": "--message-pane-background",
    "fg": "--toolbar-color",
    "muted": "--sidebar-text-color",
    "accent": "--selected-item-color",
    "quote_bar": "--splitter-color",
    "selection": "--tab-selected-bgcolor",
}

CONTENT_TEMPLATE = """\
/* userContent.css — generated by omarchy-thunderbird
 * https://github.com/Maximilian-Maag/omarchy-thunderbird
 *
 * Applied theme: %(theme)s
 *
 * Styles the message-reading pane so it follows the Omarchy palette instead of
 * Thunderbird's default white. The colours come from the same theme block used for
 * the chrome, so the message body and the surrounding UI never drift apart.
 *
 * Deliberately narrow: body background/text, links and quoted text only. Element
 * backgrounds *inside* a message are left alone, so HTML mail that specifies its own
 * design still renders the way its author intended.
 */
:root {
  --tb-bg: %(bg)s;
  --tb-fg: %(fg)s;
  --tb-muted: %(muted)s;
  --tb-accent: %(accent)s;
  --tb-quote-bar: %(quote_bar)s;
  --tb-selection: %(selection)s;
}

body {
  background-color: var(--tb-bg) !important;
  color: var(--tb-fg) !important;
}

a:link,
a:visited {
  color: var(--tb-accent) !important;
}

blockquote[type="cite"],
div.moz-cite-prefix {
  color: var(--tb-muted) !important;
  border-left: 2px solid var(--tb-quote-bar) !important;
}

::selection {
  background-color: var(--tb-selection) !important;
}
"""


def _theme_block(css: str, theme: str):
    """Body of the ``:root[data-omarchy-theme="<theme>"]`` rule, or None."""
    match = re.search(
        r':root\[data-omarchy-theme="%s"\]\s*\{(.*?)\}' % re.escape(theme),
        css, re.S)
    return match.group(1) if match else None


def _theme_decls(css: str, theme: str):
    """{variable: value} for the theme, falling back to the bundled :root block."""
    body = _theme_block(css, theme)
    resolved = theme
    if body is None:
        resolved = "catppuccin (fallback)"
        match = FALLBACK_BLOCK.search(css)
        body = match.group(2) if match else ""
    return resolved, {k: v.strip() for k, v in DECL.findall(body)}


def render(css: str, theme: str) -> str:
    """Return `css` (userChrome.css) with the theme's declarations applied to :root.

    When the theme has no block, the stylesheet's own fallback declarations are kept
    verbatim — the file must never end up with an empty :root (that would drop every
    colour to Thunderbird's defaults).
    """
    anchor = FALLBACK_BLOCK.search(css)
    body = _theme_block(css, theme)
    if body is not None:
        applied = theme
    else:
        applied = "catppuccin (fallback)"
        body = anchor.group(2) if anchor else ""

    banner = "\n  /* omarchy-thunderbird: applied theme = %s */\n" % applied

    def replacement(match):
        return match.group(1) + banner + body + match.group(3)

    out, count = FALLBACK_BLOCK.subn(replacement, css, count=1)
    if count == 0:
        # No :root block to anchor to: append an override so the theme still lands.
        out = css + "\n:root {%s%s}\n" % (banner, body)
    return out


def render_content(css: str, theme: str) -> str:
    """Return a userContent.css recoloured from the theme's palette."""
    applied, decls = _theme_decls(css, theme)
    values = {}
    for key, chrome_var in CONTENT_MAP.items():
        values[key] = decls.get(chrome_var) or decls.get("--toolbar-color") or "#000000"
    values["theme"] = applied
    return CONTENT_TEMPLATE % values


KINDS = {"chrome": render, "content": render_content}


def write_atomic(path: pathlib.Path, text: str) -> None:
    """Write `text` to `path`, replacing it — never writing *through* it.

    If the destination is a symlink (e.g. a user's existing chrome/userChrome.css
    pointing at the plugin), a plain write would follow it and overwrite whatever it
    targets — including the plugin's own source. Writing to a sibling temp file and
    os.replace()-ing it swaps the symlink itself for the real file, and leaves the
    old target untouched.
    """
    tmp = path.with_name(path.name + ".tmp")
    tmp.write_text(text)
    os.replace(tmp, path)


def main(argv=None) -> int:
    parser = argparse.ArgumentParser(description="Render applied Thunderbird stylesheets")
    parser.add_argument("theme", nargs="?", default="catppuccin",
                        help="Omarchy theme slug (e.g. tokyo-night)")
    parser.add_argument("--kind", choices=sorted(KINDS), default="chrome",
                        help="chrome -> userChrome.css, content -> userContent.css")
    parser.add_argument("--source", default=None,
                        help="path to the bundled stylesheet (default: ../themes/userChrome.css)")
    parser.add_argument("--output", default="-",
                        help="output path, or - for stdout")
    args = parser.parse_args(argv)

    source = pathlib.Path(args.source) if args.source else (
        pathlib.Path(__file__).resolve().parent.parent / "themes" / "userChrome.css")
    if not source.is_file():
        print("render-css: stylesheet not found: %s" % source, file=sys.stderr)
        return 1

    rendered = KINDS[args.kind](source.read_text(), args.theme)
    if args.output == "-":
        sys.stdout.write(rendered)
    else:
        write_atomic(pathlib.Path(args.output), rendered)
    return 0


if __name__ == "__main__":
    sys.exit(main())
