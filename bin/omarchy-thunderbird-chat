#!/usr/bin/env python3
"""Report the chat accounts configured in a Thunderbird profile.

Thunderbird's chat accounts are stored as preferences under ``chat.prpls.<protocol>.
<account>.<field>`` in the profile's ``prefs.js``. This reads those keys so the comms
widget (and you) can see which chat protocols Thunderbird actually has wired up.

    omarchy-thunderbird-chat            # human readable summary
    omarchy-thunderbird-chat --json     # machine readable

Account *creation* is deliberately not automated: a chat account needs credentials
(and often an access token) that cannot be guessed, so it stays a one-time step in
Thunderbird's own UI. This tool reports what exists; it does not invent accounts.
"""

import argparse
import json
import pathlib
import re
import subprocess
import sys

PLUGIN_DIR = pathlib.Path(__file__).resolve().parent.parent

# chat.prpls.prpl-irc.<accountkey>.<field> — protocol, then account key
ACCOUNT_PREF = re.compile(r'user_pref\(\s*"chat\.prpls\.([a-z0-9-]+)\.([A-Za-z0-9_]+)\.')


def accounts_from_prefs(text: str):
    """{protocol: sorted set of account keys} from a prefs.js body."""
    found = {}
    for protocol, account in ACCOUNT_PREF.findall(text):
        found.setdefault(protocol, set()).add(account)
    return {protocol: sorted(keys) for protocol, keys in found.items()}


def resolve_profile(explicit):
    if explicit:
        return pathlib.Path(explicit)
    finder = PLUGIN_DIR / "bin/omarchy-tb-profile"
    result = subprocess.run([sys.executable, str(finder)], capture_output=True, text=True)
    if result.returncode != 0 or not result.stdout.strip():
        return None
    return pathlib.Path(result.stdout.strip())


def main(argv=None) -> int:
    parser = argparse.ArgumentParser(description="Report Thunderbird chat accounts")
    parser.add_argument("--profile", default=None)
    parser.add_argument("--json", action="store_true")
    args = parser.parse_args(argv)

    profile = resolve_profile(args.profile)
    if profile is None or not profile.is_dir():
        print("omarchy-thunderbird-chat: no Thunderbird profile found", file=sys.stderr)
        return 1

    prefs = profile / "prefs.js"
    text = prefs.read_text(errors="replace") if prefs.is_file() else ""
    accounts = accounts_from_prefs(text)

    if args.json:
        print(json.dumps({
            "protocols": accounts,
            "accounts": sum(len(v) for v in accounts.values()),
        }, indent=2))
    elif not accounts:
        print("No chat accounts configured (add them in Thunderbird's Chat tab).")
    else:
        for protocol, keys in sorted(accounts.items()):
            print("%-14s %d account(s)" % (protocol, len(keys)))
    return 0


if __name__ == "__main__":
    sys.exit(main())
