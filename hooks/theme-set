#!/bin/bash
# omarchy hook: theme-set — apply an Omarchy theme to Thunderbird
#
# Called by: omarchy-hook theme-set <theme-name>
#
# Renders the profile's userChrome.css so that its default :root block IS the active
# theme (see bin/omarchy-tb-render-css). No userChromeJS loader is required for the
# theme to take effect — the earlier attribute-selector approach silently did nothing
# without one. Thunderbird reads chrome/userChrome.css at startup, so the change
# lands on the next launch; `omarchy-thunderbird-reload` restarts it immediately.
set -euo pipefail

THEME=$(echo "${1:-}" | tr '[:upper:]' '[:lower:]' | tr ' ' '-')
[[ -z "$THEME" ]] && exit 0

PLUGIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

PROFILE="$("$PLUGIN_DIR/bin/omarchy-tb-profile" 2>/dev/null)" || true
[[ -z "$PROFILE" || ! -d "$PROFILE" ]] && exit 0

CHROME_DIR="$PROFILE/chrome"
mkdir -p "$CHROME_DIR"

# Record the active theme — read back by the reload CLI and by tooling/tests.
echo "$THEME" > "$CHROME_DIR/omarchy-active-theme"

# Render the applied stylesheet: the active theme inlined into the :root block.
"$PLUGIN_DIR/bin/omarchy-tb-render-css" "$THEME" --output "$CHROME_DIR/userChrome.css"

# Render the message-body stylesheet too, from the same palette.
"$PLUGIN_DIR/bin/omarchy-tb-render-css" "$THEME" --kind content --output "$CHROME_DIR/userContent.css"

# Keep the attribute setter for users who run a userChromeJS loader: for them it
# switches the theme live, without a restart.
cat > "$CHROME_DIR/set-theme.uc.js" << UCJS
// Auto-generated by omarchy-thunderbird theme-set hook
(function() {
  const theme = "${THEME}";
  document.documentElement.setAttribute("data-omarchy-theme", theme);
  document.documentElement.style.setProperty("--omarchy-theme", JSON.stringify(theme));
})();
UCJS

# Optional immediate reload on every theme switch: opt in by exporting
# OMARCHY_THUNDERBIRD_AUTORELOAD=1 (off by default — a restart is intrusive).
if [[ "${OMARCHY_THUNDERBIRD_AUTORELOAD:-0}" == "1" ]]; then
  "$PLUGIN_DIR/bin/omarchy-thunderbird-reload" "$THEME" >/dev/null 2>&1 || true
fi
