#!/bin/bash
# omarchy hook: theme-set — apply Omarchy theme to Thunderbird
#
# Called by: omarchy-hook theme-set <theme-name>
# Writes the theme name into the Thunderbird profile's chrome/omarchy-theme
# state file and triggers a CSS reload by touching userChrome.css.

set -euo pipefail

THEME=$(echo "${1:-}" | tr '[:upper:]' '[:lower:]' | tr ' ' '-')
[[ -z "$THEME" ]] && exit 0

PLUGIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
TB_CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/thunderbird"

# Find the default-release profile
find_profile() {
  python3 - "$TB_CONFIG" << 'EOF'
import configparser, os, sys
p = configparser.ConfigParser()
p.read(os.path.join(sys.argv[1], "profiles.ini"))
# prefer default-release, then Default=1, then first
for section in p.sections():
    if p.has_option(section, "Path") and "default-release" in p.get(section, "Path", fallback=""):
        print(os.path.join(sys.argv[1], p.get(section, "Path")))
        sys.exit(0)
for section in p.sections():
    if p.has_option(section, "Path") and p.get(section, "Default", fallback="0") == "1":
        print(os.path.join(sys.argv[1], p.get(section, "Path")))
        sys.exit(0)
for section in p.sections():
    if p.has_option(section, "Path") and p.has_option(section, "IsRelative"):
        print(os.path.join(sys.argv[1], p.get(section, "Path")))
        sys.exit(0)
EOF
}

PROFILE=$(find_profile 2>/dev/null) || true
[[ -z "$PROFILE" || ! -d "$PROFILE" ]] && exit 0

CHROME_DIR="$PROFILE/chrome"
mkdir -p "$CHROME_DIR"

# Write the active theme state file read by userChrome.css loader
echo "$THEME" > "$CHROME_DIR/omarchy-active-theme"

# If userChrome.css is a symlink to our plugin file, touch it to force reload.
# TB reloads userChrome.css when it changes on disk.
CSS_LINK="$CHROME_DIR/userChrome.css"
if [[ -L "$CSS_LINK" ]]; then
  touch -h "$CSS_LINK" 2>/dev/null || true
fi

# Write a minimal userChrome.js that sets the data-omarchy-theme attribute
# on the root element so our CSS :root[data-omarchy-theme="X"] selectors fire.
# This file is executed by userchrome.js loader if installed.
cat > "$CHROME_DIR/set-theme.uc.js" << UCJS
// Auto-generated by omarchy-thunderbird theme-set hook
(function() {
  const theme = "${THEME}";
  document.documentElement.setAttribute("data-omarchy-theme", theme);
  document.documentElement.style.setProperty("--omarchy-theme", JSON.stringify(theme));
})();
UCJS
